{
  "openapi": "3.1.0",
  "info": {
    "title": "Bittrees AI local API",
    "version": "1.0.0"
  },
  "paths": {
    "/v1/requests": {
      "post": {
        "security": [
          {
            "localBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/request"
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Accepted"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Denied"
          },
          "409": {
            "description": "Conflicting revision or idempotency key"
          }
        }
      }
    },
    "/v1/requests/{id}/commands": {
      "parameters": [
        {
          "name": "id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        }
      ],
      "post": {
        "security": [
          {
            "localBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/command"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Accepted"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Denied"
          },
          "409": {
            "description": "Conflicting revision or idempotency key"
          }
        }
      }
    },
    "/v1/messages": {
      "post": {
        "security": [
          {
            "localBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/message"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Accepted"
          },
          "400": {
            "description": "Invalid input"
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Denied"
          },
          "409": {
            "description": "Conflicting revision or idempotency key"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "authority": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "userId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "subjectId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "agentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "sourceApp": {
            "type": "string",
            "enum": [
              "local",
              "crm",
              "autonote",
              "roles",
              "mail",
              "news",
              "mcp"
            ]
          },
          "grantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "policyRevision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          }
        },
        "required": [
          "userId",
          "subjectId",
          "tenantId",
          "deviceId",
          "sourceApp",
          "grantId",
          "policyRevision"
        ],
        "additionalProperties": false
      },
      "request": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "query",
              "summarize",
              "draft"
            ]
          },
          "prompt": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "modelProfileId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "sourceRefs": {
            "default": [],
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "app": {
                  "type": "string",
                  "enum": [
                    "local",
                    "crm",
                    "autonote",
                    "roles",
                    "mail",
                    "news",
                    "mcp"
                  ]
                },
                "tenantId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9:_-]+$"
                },
                "resourceId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9:_-]+$"
                },
                "revision": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9:_-]+$"
                }
              },
              "required": [
                "app",
                "tenantId",
                "resourceId",
                "revision"
              ],
              "additionalProperties": false
            }
          },
          "dependencies": {
            "default": [],
            "maxItems": 32,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9:_-]+$"
            }
          },
          "priority": {
            "default": "normal",
            "type": "string",
            "enum": [
              "normal",
              "high"
            ]
          },
          "deadline": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "tags": {
            "default": [],
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40
            }
          }
        },
        "required": [
          "conversationId",
          "kind",
          "prompt",
          "modelProfileId",
          "sourceRefs",
          "dependencies",
          "priority",
          "tags"
        ],
        "additionalProperties": false
      },
      "sourceRef": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "app": {
            "type": "string",
            "enum": [
              "local",
              "crm",
              "autonote",
              "roles",
              "mail",
              "news",
              "mcp"
            ]
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "resourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          }
        },
        "required": [
          "app",
          "tenantId",
          "resourceId",
          "revision"
        ],
        "additionalProperties": false
      },
      "inbox": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "tenantId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "ownerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "ownerType": {
            "type": "string",
            "enum": [
              "user",
              "agent",
              "manager"
            ]
          },
          "teamId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "memberUserIds": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128,
              "pattern": "^[A-Za-z0-9:_-]+$"
            }
          }
        },
        "required": [
          "id",
          "tenantId",
          "ownerId",
          "ownerType",
          "memberUserIds"
        ],
        "additionalProperties": false
      },
      "message": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "conversationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "recipientInboxId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "type": {
            "type": "string",
            "enum": [
              "query",
              "reply",
              "clarification",
              "notification"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32000
          },
          "replyToId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "replyExpected": {
            "default": false,
            "type": "boolean"
          },
          "replyDueAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          }
        },
        "required": [
          "conversationId",
          "recipientInboxId",
          "type",
          "content",
          "replyExpected"
        ],
        "additionalProperties": false
      },
      "command": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "pause",
              "resume",
              "cancel"
            ]
          },
          "expectedRevision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "command",
          "expectedRevision"
        ],
        "additionalProperties": false
      },
      "connectorManifest": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "contractVersion": {
            "type": "string",
            "const": "1.0.0"
          },
          "app": {
            "type": "string",
            "enum": [
              "local",
              "crm",
              "autonote",
              "roles",
              "mail",
              "news",
              "mcp"
            ]
          },
          "origin": {
            "type": "string",
            "format": "uri"
          },
          "actions": {
            "maxItems": 6,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "read",
                "draft",
                "publish",
                "send",
                "explain_access"
              ]
            }
          },
          "authentication": {
            "type": "string",
            "enum": [
              "authorization_code_pkce",
              "expiring_key"
            ]
          }
        },
        "required": [
          "contractVersion",
          "app",
          "origin",
          "actions",
          "authentication"
        ],
        "additionalProperties": false
      },
      "remoteStatus": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "deviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "running",
              "awaiting_input",
              "awaiting_approval",
              "paused",
              "completed",
              "failed",
              "cancelled",
              "expired"
            ]
          },
          "revision": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z))$"
          },
          "errorCode": {
            "type": "string",
            "enum": [
              "MODEL_UNAVAILABLE",
              "AUTHORITY_EXPIRED",
              "CONFLICT",
              "CAPACITY",
              "INTERNAL"
            ]
          }
        },
        "required": [
          "id",
          "deviceId",
          "status",
          "revision",
          "updatedAt"
        ],
        "additionalProperties": false
      },
      "error": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "enum": [
              "INVALID_INPUT",
              "UNAUTHORIZED",
              "FORBIDDEN",
              "NOT_FOUND",
              "CONFLICT",
              "STALE_CLAIM",
              "EXPIRED",
              "CAPACITY",
              "INTERNAL"
            ]
          },
          "correlationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          }
        },
        "required": [
          "error",
          "correlationId"
        ],
        "additionalProperties": false
      },
      "modelProfile": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9:_-]+$"
          },
          "runtime": {
            "type": "string",
            "enum": [
              "ollama",
              "lmstudio"
            ]
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "contextTokens": {
            "type": "integer",
            "minimum": 256,
            "maximum": 131072
          },
          "maxOutputTokens": {
            "type": "integer",
            "minimum": 1,
            "maximum": 8192
          },
          "temperature": {
            "type": "number",
            "minimum": 0,
            "maximum": 2
          }
        },
        "required": [
          "id",
          "runtime",
          "model",
          "contextTokens",
          "maxOutputTokens",
          "temperature"
        ],
        "additionalProperties": false
      }
    },
    "securitySchemes": {
      "localBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
